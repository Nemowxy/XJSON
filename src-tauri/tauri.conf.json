{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XJSON",
  "version": "0.1.0",
  "identifier": "com.xway.xjson",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XJSON",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-eval'; worker-src 'self' blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["json", "jsonc", "json5"],
        "name": "JSON Document",
        "description": "JSON Document",
        "role": "Editor"
      },
      {
        "ext": ["cfg", "conf", "config"],
        "name": "Config File",
        "description": "Configuration File",
        "role": "Editor"
      },
      {
        "ext": ["lock"],
        "name": "Lock File",
        "description": "Lock File",
        "role": "Editor"
      }
    ]
  }
}
